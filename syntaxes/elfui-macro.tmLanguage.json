{
  "name": "ElfUI Macro Embedded Languages",
  "scopeName": "elfui.macro.injection",
  "injectionSelector": "L:source.ts -comment -string, L:source.js -comment -string, L:text.html.basic -comment, L:text.html.derivative -comment",
  "patterns": [
    {
      "include": "#defineHtmlCall"
    },
    {
      "include": "#defineHtmlCallMultiLine"
    },
    {
      "include": "#defineFragmentCall"
    },
    {
      "include": "#fragmentTaggedTemplate"
    },
    {
      "include": "#styleCall"
    },
    {
      "include": "#styleCallMultiLine"
    },
    {
      "include": "#quotedDirectiveExpression"
    },
    {
      "include": "#interpolation"
    }
  ],
  "repository": {
    "defineFragmentCall": {
      "begin": "\\b(defineFragment)\\s*(?:<[^>]*>)?\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.template entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.section.parens.begin.elfui meta.brace.round.ts"
        }
      },
      "end": "\\)\\s*;?\\s*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.elfui meta.brace.round.ts"
        }
      },
      "patterns": [
        {
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.end.elfui string.template.ts"
            }
          },
          "contentName": "meta.embedded.block.html text.html.derivative",
          "patterns": [
            {
              "include": "#templateContent"
            }
          ]
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "fragmentTaggedTemplate": {
      "begin": "\\b(fragment)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.template entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.elfui string.template.ts"
        }
      },
      "contentName": "meta.embedded.block.html text.html.derivative",
      "patterns": [
        {
          "include": "#templateContent"
        }
      ]
    },
    "defineHtmlCall": {
      "begin": "\\b(defineHtml)\\s*(?:<[^`]*?>\\s*)?(\\()\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.template entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.section.parens.begin.elfui meta.brace.round.ts"
        },
        "3": {
          "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
        }
      },
      "end": "(`)\\s*(\\))?",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.end.elfui string.template.ts"
        },
        "2": {
          "name": "punctuation.section.parens.end.elfui meta.brace.round.ts"
        }
      },
      "contentName": "meta.embedded.block.html text.html.derivative",
      "patterns": [
        {
          "include": "#templateContent"
        }
      ]
    },
    "defineHtmlCallMultiLine": {
      "begin": "\\b(defineHtml)\\s*(?:<[^`]*?>\\s*)?(\\()(?=\\s*$)",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.template entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.section.parens.begin.elfui meta.brace.round.ts"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.elfui meta.brace.round.ts"
        }
      },
      "patterns": [
        {
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.end.elfui string.template.ts"
            }
          },
          "contentName": "meta.embedded.block.html text.html.derivative",
          "patterns": [
            {
              "include": "#templateContent"
            }
          ]
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "styleCall": {
      "begin": "\\b(defineStyle)\\s*(\\()\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.style entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.section.parens.begin.elfui meta.brace.round.ts"
        },
        "3": {
          "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
        }
      },
      "end": "(`)\\s*(\\))?",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.end.elfui string.template.ts"
        },
        "2": {
          "name": "punctuation.section.parens.end.elfui meta.brace.round.ts"
        }
      },
      "contentName": "meta.embedded.block.css source.css",
      "patterns": [
        {
          "include": "#cssComment"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "source.css"
        }
      ]
    },
    "styleCallMultiLine": {
      "begin": "\\b(defineStyle)\\s*(\\()(?=\\s*$)",
      "beginCaptures": {
        "1": {
          "name": "support.function.elfui.style entity.name.function.elfui"
        },
        "2": {
          "name": "punctuation.section.parens.begin.elfui meta.brace.round.ts"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.elfui meta.brace.round.ts"
        }
      },
      "patterns": [
        {
          "begin": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.begin.elfui string.template.ts"
            }
          },
          "end": "`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.end.elfui string.template.ts"
            }
          },
          "contentName": "meta.embedded.block.css source.css",
          "patterns": [
            {
              "include": "#cssComment"
            },
            {
              "include": "#interpolation"
            },
            {
              "include": "source.css"
            }
          ]
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "elfuiComponentTag": {
      "begin": "(</?)([A-Z][A-Za-z0-9]*|[a-z][a-z0-9]*-[a-z0-9-]+)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.elfui"
        },
        "2": {
          "name": "support.class.component.elfui entity.name.tag.component.elfui"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.elfui"
        }
      },
      "patterns": [
        {
          "include": "#elfuiTagContent"
        }
      ]
    },
    "elfuiNativeTag": {
      "begin": "(</?)([a-z][a-z0-9]*)\\b",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.html"
        }
      },
      "patterns": [
        {
          "include": "#elfuiTagContent"
        }
      ]
    },
    "elfuiTagContent": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#quotedDirectiveExpression"
        },
        {
          "match": "(?:[:@][\\w:-]+(?:\\.[\\w-]+)*|v-(?:bind(?::[\\w-]+)?|if|else-if|show|model|text|html|memo))(?=\\s*=)",
          "name": "entity.other.attribute-name.directive.elfui"
        },
        {
          "match": "[A-Za-z_][\\w:.-]*(?=\\s*=)",
          "name": "entity.other.attribute-name.html"
        },
        {
          "begin": "([\\\"'])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.html"
            }
          },
          "end": "\\1",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.html"
            }
          },
          "contentName": "string.quoted.html",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "templateContent": {
      "patterns": [
        {
          "include": "#htmlComment"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#elfuiComponentTag"
        },
        {
          "include": "#elfuiNativeTag"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "htmlComment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.html"
        }
      },
      "end": "-->",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.html"
        }
      }
    },
    "cssComment": {
      "name": "comment.block.css",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.css"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.css"
        }
      }
    },
    "quotedDirectiveExpression": {
      "begin": "((?:[:@][\\w:-]+(?:\\.[\\w-]+)*|v-(?:bind(?::[\\w-]+)?|if|else-if|show|model|text|html|memo)))(\\s*=\\s*)([\\\"'])",
      "beginCaptures": {
        "1": {
          "name": "entity.other.attribute-name.directive.elfui"
        },
        "2": {
          "name": "punctuation.separator.key-value.html"
        },
        "3": {
          "name": "punctuation.definition.string.begin.html"
        }
      },
      "end": "\\3",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.html"
        }
      },
      "contentName": "meta.embedded.expression.elfui source.ts",
      "patterns": [
        {
          "include": "source.ts"
        }
      ]
    },
    "interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.ts"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.ts"
        }
      },
      "contentName": "meta.template.expression.ts",
      "patterns": [
        {
          "include": "#interpolationBrace"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "interpolationBrace": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.ts"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.ts"
        }
      },
      "patterns": [
        {
          "include": "#interpolationBrace"
        },
        {
          "include": "source.ts"
        }
      ]
    }
  }
}
